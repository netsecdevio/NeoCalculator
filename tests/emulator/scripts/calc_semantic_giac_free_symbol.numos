# Free-symbol evaluation uses the exact reduction and session Ans policy
# documented in CALCULATION_FORMAT_01.md. The legacy numeric mirror remains
# unchanged until a representable numeric result is produced.

log "calc_semantic_giac_free_symbol: waiting for launcher"
wait 200
open_app Calculation
wait 60

# Seed Ans with 4.
key 2
key +
key 2
key ENTER
wait 120
assert_variable ans 4

key ac
wait 10

key x
key -
key 2
key *
key x
key ENTER
wait 120

assert_app Calculation
assert_no_error
assert_calc_status ok
assert_calc_result_kind structured
assert_calc_exact -x

# The legacy numeric mirror remains 4, but session Ans holds -x.
assert_variable ans 4
key ac
key ans
key +
key x
key ENTER
wait 120
assert_no_error
assert_calc_exact 0
assert_variable ans 0
log "calc_semantic_giac_free_symbol: PASS (symbolic reduction and exact session Ans)"
